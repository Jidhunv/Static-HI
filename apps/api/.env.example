NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hotel_inventory_dev"

# Auth
# Required. Private random value, at least 32 characters. The API will not start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS
CORS_ORIGINS="http://localhost:3200"

# File storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=hotel-inventory-dev

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Required for MFA. 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Payments are verified with Stripe using STRIPE_SECRET_KEY. Without it they are refused, unless this is
# set to true (local development only; ignored when NODE_ENV=production).
ALLOW_UNVERIFIED_PAYMENTS=false
