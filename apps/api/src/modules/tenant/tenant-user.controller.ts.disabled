import { Controller, Post, Get, Put, Delete, Body, Param, Query, UseGuards } from '@nestjs/common';
import { TenantUserService } from './tenant-user.service';
import { CurrentTenant } from '../../shared/decorators/current-tenant.decorator';
import { CurrentUser } from '../../shared/decorators/current-user.decorator';

@Controller('tenants/:tenantId/users')
export class TenantUserController {
  constructor(private service: TenantUserService) {}

  @Post()
  async create(
    @Param('tenantId') tenantId: string,
    @Body() body: { email: string; password: string; firstName: string; lastName: string; roles?: string[] },
  ) {
    return this.service.createUser(tenantId, body);
  }

  @Get()
  async list(
    @Param('tenantId') tenantId: string,
    @Query('status') status?: string,
  ) {
    return this.service.listUsers(tenantId, { status });
  }

  @Get(':userId')
  async get(
    @Param('tenantId') tenantId: string,
    @Param('userId') userId: string,
  ) {
    return this.service.getUser(userId, tenantId);
  }

  @Put(':userId')
  async update(
    @Param('tenantId') tenantId: string,
    @Param('userId') userId: string,
    @Body() body: Partial<{ firstName: string; lastName: string; permissions: string[] }>,
  ) {
    return this.service.updateUser(userId, tenantId, body);
  }

  @Put(':userId/roles')
  async assignRoles(
    @Param('tenantId') tenantId: string,
    @Param('userId') userId: string,
    @Body() body: { permissions: string[] },
  ) {
    return this.service.assignRoles(userId, tenantId, body.permissions);
  }

  @Put(':userId/status')
  async updateStatus(
    @Param('tenantId') tenantId: string,
    @Param('userId') userId: string,
    @Body() body: { status: 'active' | 'inactive' | 'suspended' },
  ) {
    return this.service.updateStatus(userId, tenantId, body.status);
  }

  @Delete(':userId')
  async delete(
    @Param('tenantId') tenantId: string,
    @Param('userId') userId: string,
  ) {
    return this.service.deleteUser(userId, tenantId);
  }

  @Get(':userId/permissions')
  async getPermissions(
    @Param('tenantId') tenantId: string,
    @Param('userId') userId: string,
  ) {
    return { permissions: await this.service.getPermissions(userId, tenantId) };
  }
}
