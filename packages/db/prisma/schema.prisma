// ============================================================================
// RATE MARKUP & DISTRIBUTION
// ============================================================================

model RateMarkup {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channel String /// b2b, b2c

  /// Optional scoping
  sourceTenantId String? /// for b2b: only when reselling this specific tenant's inventory
  roomTypeCode   String? /// applies to this room type

  dateStart DateTime?
  dateEnd   DateTime?
  minLOS    Int?

  /// Markup rule
  type     String /// percentage, fixed
  value    Float
  priority Int    @default(0) /// higher = more specific, wins in conflict

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, channel, sourceTenantId, roomTypeCode, dateStart, dateEnd, minLOS])
  @@index([tenantId, channel])
  @@index([priority])
}

model DistributionGrant {
  id             String @id @default(cuid())
  sourceTenantId String
  sourceTenant   Tenant @relation("source_tenant", fields: [sourceTenantId], references: [id], onDelete: Cascade)

  targetTenantId String
  targetTenant   Tenant @relation("target_tenant", fields: [targetTenantId], references: [id], onDelete: Cascade)

  status String @default("pending") /// pending, approved, rejected

  /// Optional bilateral override
  customB2BMargin Int? /// % margin override just for this grant

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceTenantId, targetTenantId])
  @@index([sourceTenantId])
  @@index([targetTenantId])
  @@index([status])
}

// ============================================================================
// BOOKINGS & PAYMENTS - Models below removed (duplicate Booking model)
// ============================================================================

model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  itemType    String /// room, fee, surcharge, tax, discount
  description String
  quantity    Int    @default(1)
  unitPrice   Float
  total       Float /// quantity * unitPrice

  @@index([bookingId])
}

model RateBreakdown {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  sourceTenantId   String /// base data for audit
  resellerTenantId String?

  netRate          Float /// per night, secret
  b2bMarginApplied Float? /// if B2B, markup applied by source
  marketplaceRate  Float? /// netRate + b2bMarginApplied
  resellerMarkup   Float? /// reseller's own markup

  b2cMarkupApplied Float? /// if B2C, direct markup applied

  taxTotal        Float
  feesTotal       Float
  surchargesTotal Float

  finalRate Float /// the final sell rate

  /// JSON audit trail
  markupHistory String @db.Text /// [{applied_by: tenant_id, type: "b2b" | "b2c", value, timestamp}]

  @@index([sourceTenantId])
  @@index([resellerTenantId])
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  status String @default("pending") /// pending, succeeded, failed
  method String @default("stripe") /// stripe, bank_transfer, etc.

  stripePaymentIntentId  String?
  stripeConnectAccountId String? /// the tenant's stripe account ID

  amount   Float
  currency String

  platformCommission Float /// platform's take
  tenantCredit       Float /// amount credited to tenant

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([bookingId])
  @@index([status])
}

// ============================================================================
// PHASE 1: FOUNDATIONAL FEATURES
// ============================================================================

// 1. ENTITY APPROVAL PATTERN (Reusable for Tenant & B2B Agent)
model EntityApproval {
  id String @id @default(cuid())

  entityType String /// Tenant, B2BAgent
  entityId   String

  status String @default("pending") /// pending, confirmed, suspended

  approverUserId String? /// who approved/rejected
  approverEmail  String?
  approverName   String?

  approvalNotes String?   @db.Text
  actionTakenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([status])
  @@index([createdAt])
}

// 2. INVENTORY LEDGER (Append-only, foundational for booking consistency)
model InventoryLedger {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  ratePlanId String
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  date DateTime /// The date this availability applies to

  delta  Int /// Positive or negative availability change
  reason String /// manual_allocation, booking, cancellation_release, amendment, blackout_block

  actorUserId String? /// User who triggered this change
  actorEmail  String?

  bookingId String? /// If reason=booking/cancellation/amendment, link to booking

  createdAt DateTime @default(now())

  /// Immutable: this row is never updated or deleted

  @@index([propertyId, roomId, ratePlanId, date])
  @@index([reason])
  @@index([bookingId])
  @@index([createdAt])
}

// 3. CURRENT AVAILABILITY (Materialized view for fast reads, updated transactionally with ledger)
model CurrentAvailability {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  ratePlanId String
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  date DateTime

  available Int /// Sum of all delta in InventoryLedger for this (property, room, rate, date)

  lastUpdatedAt DateTime @updatedAt

  @@unique([propertyId, roomId, ratePlanId, date])
  @@index([propertyId, roomId, ratePlanId, date])
}

// 4. FX RATES (Manual + API-driven)
model FXRate {
  id String @id @default(cuid())

  baseCurrencyId String
  baseCurrency   Currency @relation("fx_base", fields: [baseCurrencyId], references: [id], onDelete: Cascade)

  quoteCurrencyId String
  quoteCurrency   Currency @relation("fx_quote", fields: [quoteCurrencyId], references: [id], onDelete: Cascade)

  rate        Decimal @db.Decimal(18, 8) /// 1 base = rate quote
  source      String /// manual, api
  apiProvider String? /// e.g., "forex_api", "exchangerate", etc.

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relations
  history FXRateHistory[]

  @@unique([baseCurrencyId, quoteCurrencyId])
  @@index([updatedAt])
}

// 4.1 FX RATE HISTORY (Append-only audit trail for rate changes)
model FXRateHistory {
  id String @id @default(cuid())

  fxRateId String
  fxRate   FXRate @relation(fields: [fxRateId], references: [id], onDelete: Cascade)

  baseCurrencyId  String
  quoteCurrencyId String

  rate        Decimal @db.Decimal(18, 8) /// 1 base = rate quote
  source      String /// manual, api
  apiProvider String?

  updatedBy    String? /// User ID who made manual update
  updateReason String? /// "manual_update", "api_sync", "correction"

  createdAt DateTime @default(now())

  @@index([fxRateId, createdAt])
  @@index([createdAt])
  @@index([baseCurrencyId, quoteCurrencyId, createdAt])
}

