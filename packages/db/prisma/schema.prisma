generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// TENANTS & AUTH
// ============================================================================

model Tenant {
  id              String @id @default(cuid())
  name            String
  slug            String @unique /// lowercase, used in subdomain
  businessType    String /// hotel_chain, dmc, ota, wholesaler, travel_agency
  status          String @default("pending") /// pending, active, suspended
  primaryCurrency String @default("USD")

  // Branding / white-label
  logoUrl        String?
  primaryColor   String? @default("#7c3aed") /// default: lavender
  secondaryColor String?
  fontFamily     String? @default("inter") /// inter, roboto, poppins, etc.

  // Finance & KYC
  kycStatus            String   @default("pending") /// pending, verified, rejected
  kycDocuments         String[] /// JSON paths to uploaded docs
  bankAccountEncrypted String? /// encrypted JSON: {accountNumber, ifsc, beneficiaryName, accountType}
  panEncrypted         String? /// encrypted
  gstEncrypted         String? /// encrypted

  // Defaults
  defaultB2BMargin Int @default(15) /// percentage
  defaultB2CMarkup Int @default(25) /// percentage
  commissionRate   Int @default(5) /// platform take-rate on B2B/B2C, %

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                 TenantUser[]
  properties            Property[]
  suppliers             Supplier[]
  rateMarkups           RateMarkup[]
  outgoingDistributions DistributionGrant[]     @relation("source_tenant")
  incomingDistributions DistributionGrant[]     @relation("target_tenant")
  settings              TenantSettings?
  propertyConfigs       PropertyConfiguration[] @relation("tenant_property_config")
  propertyRates         PropertyRate[]          @relation("tenant_rates")
  tenantBookings        Booking[]               @relation("tenant_bookings")
  auditLogs             AuditLog[]
  b2bUsers              B2BUser[]               @relation("b2b_users")
  roles                 TenantRole[]            @relation("tenant_roles")
  b2bAgents             B2BAgent[]              @relation("tenant_b2b_agents")
  commissions           Commission[]            @relation("tenant_commissions")
  settlements           Settlement[]            @relation("tenant_settlements")
  apiKeys               ApiKey[]                @relation("tenant_api_keys")

  // Multi-supplier relations
  outgoingPartnerships SupplierPartnership[]    @relation("partnership_source")
  incomingPartnerships SupplierPartnership[]    @relation("partnership_target")
  inventorySupplier    InventoryVisibility[]    @relation("inventory_supplier")
  commissionRules      SupplierCommissionRule[] @relation("commission_rules")
  supplierInvoices     SupplierInvoice[]        @relation("supplier_invoices")
  supplierSettlements  SupplierSettlement[]     @relation("supplier_settlements")

  @@index([status])
  @@index([slug])
}

model TenantSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Per-tenant master overrides
  allowedAmenities String[] /// JSON array of amenity IDs this tenant can use
  allowedCountries String[] /// restrict booking to certain countries
  bookingWindow    Int      @default(365) /// max days in advance

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model ApiKey {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation("tenant_api_keys", fields: [tenantId], references: [id], onDelete: Cascade)

  // API Key (hashed in DB)
  keyHash   String @unique /// SHA256 hash of the actual key
  keyPrefix String /// First 8 characters of key for display (e.g., "sk_live_ab12...")

  // Key Details
  name        String /// e.g., "Mobile App", "Web Frontend", "OTA Integration"
  description String? /// Optional description of key usage

  // Permissions
  permissions String[] /// ["search", "booking.create", "booking.read", "booking.cancel", etc.]

  // Rate Limiting
  rateLimit Int @default(1000) /// requests per minute

  // Access Control
  allowedOrigins String[] /// CORS origins allowed to use this key (empty = all)
  allowedIPs     String[] /// IP addresses allowed (empty = all)

  // Metadata
  lastUsedAt DateTime?
  createdBy  String? /// User ID who created the key

  // Status
  status    String    @default("active") /// active, revoked, suspended
  expiresAt DateTime? /// Optional expiration date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  apiLogs ApiLog[]

  @@index([tenantId])
  @@index([keyHash])
  @@index([status])
  @@index([expiresAt])
}

model ApiLog {
  id       String @id @default(cuid())
  apiKeyId String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  // Request Details
  method     String /// GET, POST, etc.
  endpoint   String /// /b2c/search, /b2c/bookings, etc.
  statusCode Int /// 200, 400, 401, 429, etc.

  // Response Info
  responseTime Int /// milliseconds
  errorMessage String? /// Error message if failed

  // Client Info
  ipAddress String
  userAgent String?
  origin    String?

  createdAt DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([statusCode])
  @@index([createdAt])
}

model TenantUser {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email     String
  password  String /// hashed
  firstName String
  lastName  String
  role      String /// admin, staff

  // Staff scoping
  permissions String[] /// module_view, module_edit, etc. — JSON array

  emailVerified Boolean   @default(false)
  status        String    @default("active") /// active, inactive, suspended
  lastLogin     DateTime?

  // Two-factor authentication (TOTP)
  mfaEnabled     Boolean  @default(false)
  mfaSecret      String? /// AES-256-GCM encrypted TOTP secret
  mfaBackupCodes String[] @default([]) /// SHA-256 hashes, single use
  mfaLastStep    Int? /// last accepted TOTP time step (replay protection)

  roles TenantRole[] @relation("user_roles")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model PlatformAdmin {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String /// hashed
  name      String
  role      String    @default("admin") /// admin, superadmin
  status    String    @default("active") /// active, inactive, suspended
  lastLogin DateTime?

  // Two-factor authentication (TOTP)
  mfaEnabled     Boolean  @default(false)
  mfaSecret      String? /// AES-256-GCM encrypted TOTP secret
  mfaBackupCodes String[] @default([]) /// SHA-256 hashes, single use
  mfaLastStep    Int? /// last accepted TOTP time step (replay protection)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id       String  @id @default(cuid())
  tenantId String? /// null if platform admin action
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId    String /// TenantUser or PlatformAdmin ID
  userEmail String
  userName  String

  action     String /// create, update, delete, view, login, logout
  entity     String /// User, Property, Booking, B2BAgent, Commission, Settlement
  entityId   String? /// ID of affected entity
  entityName String? /// Name for readability

  changes      Json? /// old vs new values {old: {}, new: {}}
  status       String  @default("success") /// success, failure
  errorMessage String?
  ipAddress    String?
  userAgent    String?

  isArchived Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@index([isArchived])
}

// ============================================================================
// PLATFORM MASTERS (not tenant-scoped)
// ============================================================================

model GlobalHotel {
  id               String   @id @default(cuid())
  /// from source data import
  name             String
  address          String
  city             String
  state            String?
  country          String
  postalCode       String?
  latitude         Float
  longitude        Float
  starRating       Int?
  chainAffiliation String?
  amenitiesMaster  String[] /// JSON array of standardized amenity codes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  properties Property[]

  @@unique([name, country, latitude, longitude]) /// prevent duplicates
  @@index([name, country])
  @@index([city, country])
}

model Country {
  id        String   @id @default(cuid())
  code      String   @unique /// ISO 3166-1 alpha-2
  name      String   @unique
  createdAt DateTime @default(now())

  states     State[]
  properties Property[] @relation("property_country")

  @@index([name])
}

model State {
  id        String   @id @default(cuid())
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  createdAt DateTime @default(now())

  properties Property[] @relation("property_state")

  @@unique([countryId, name])
  @@index([countryId])
}

model City {
  id          String   @id @default(cuid())
  name        String
  countryCode String /// denormalized for fast lookup
  createdAt   DateTime @default(now())

  @@unique([name, countryCode])
  @@index([name, countryCode])
}

model Currency {
  id           String   @id @default(cuid())
  code         String   @unique /// USD, EUR, INR, etc.
  name         String
  symbol       String
  exchangeRate Float    @default(1.0) /// vs USD base
  createdAt    DateTime @default(now())

  /// Phase 1: FX relations
  fxRatesAsBase  FXRate[] @relation("fx_base")
  fxRatesAsQuote FXRate[] @relation("fx_quote")
}

model Amenity {
  id        String   @id @default(cuid())
  code      String   @unique /// WIFI, AC, PARKING, etc.
  name      String
  category  String /// wifi, climate, parking, entertainment, etc.
  icon      String?
  createdAt DateTime @default(now())

  @@index([category])
}

model BedType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String /// Single, Double, Queen, King, Twin, etc.
  createdAt DateTime @default(now())
}

model BoardCode {
  id          String   @id @default(cuid())
  code        String   @unique /// BB, HB, FB, etc.
  name        String /// Bed & Breakfast, Half Board, Full Board
  description String?
  createdAt   DateTime @default(now())
}

model CancellationPolicyTemplate {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isDefault])
}

model Tax {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique /// VAT, GST, etc.
  percentage  Float
  isInclusive Boolean  @default(false) /// in price or added on top
  createdAt   DateTime @default(now())

  @@index([code])
}

model Chain {
  id        String   @id @default(cuid())
  name      String   @unique
  logo      String?
  createdAt DateTime @default(now())
}

model LegalInformationType {
  id        String   @id @default(cuid())
  name      String   @unique /// PAN Certificate, GST Certificate, etc.
  code      String   @unique
  createdAt DateTime @default(now())
}

// ============================================================================
// PROPERTY & INVENTORY
// ============================================================================

model Property {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  globalHotelId String?
  globalHotel   GlobalHotel? @relation(fields: [globalHotelId], references: [id])

  name String
  code String /// auto-generated, unique per tenant
  type String /// Hotel, Resort, Hostel, Vacation Rental, etc.

  countryId  String
  country    Country @relation("property_country", fields: [countryId], references: [id])
  stateId    String?
  state      State?  @relation("property_state", fields: [stateId], references: [id])
  city       String
  area       String? /// Area/Region/District
  address    String
  postalCode String?
  latitude   Float
  longitude  Float

  // Contact Info
  phone   String?
  email   String?
  website String?

  // Amenities
  amenities String[] /// JSON array of amenity names

  starCategory Int? /// 1-5 stars
  chainId      String? /// FK to Chain
  chainName    String? /// denormalized for fast lookup

  checkInTime  String @default("14:00")
  checkOutTime String @default("12:00")

  status          String  @default("active") /// active, inactive, archived
  inactiveComment String?

  // Policies
  allowEarlyCheckIn Boolean @default(false)
  allowLateCheckOut Boolean @default(false)
  allowChildren     String  @default("yes") /// yes, no
  childrenPolicy    String? /// free child up to X, or text

  // Finance
  disableTDS   Boolean  @default(false)
  contractedBy String[] /// JSON array of supplier IDs or names

  // Supplier flag
  isSupplier       Boolean @default(false) /// if true, this property can also act as a supplier to others
  applicableForROH Boolean @default(false) /// Run of House

  // Visibility & Distribution
  visibility       String @default("private") /// private, public_b2b, public_b2c, public_both
  distributionMode String @default("open") /// open, permissioned — only relevant if visibility includes b2b

  // Content
  description String?
  usp         String? /// Unique Selling Proposition
  photos      PropertyPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rooms          Room[]
  ratePlans      RatePlan[]
  policies       CancellationPolicy[]
  chargeRules    ChargeRule[]
  documents      PropertyDocument[]
  bankDetails    PropertyBankDetail[]
  suppliers      Supplier[]              @relation("property_suppliers")
  promotions     Promotion[]
  bookings       Booking[]               @relation("property_bookings")
  propertyConfig PropertyConfiguration[] @relation("property_config")
  propertyRates  PropertyRate[]          @relation("property_rates")

  /// Phase 1: Inventory ledger
  inventoryLedger     InventoryLedger[]
  currentAvailability CurrentAvailability[]
  inventoryVisibilities InventoryVisibility[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([visibility])
  @@index([distributionMode])
  @@index([chainName])
  @@index([city])
}

model PropertyPhoto {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  url       String /// signed S3 URL
  label     String /// Living Room, Bedroom, Pool, etc.
  imageName String?
  isHero    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([propertyId])
}

model PropertyDocument {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  legalInformationType String
  documentUrl          String /// signed S3 URL
  expiryDate           DateTime?
  reminder1Alert       Int? /// days before expiry
  reminder2Alert       Int?
  reminder3Alert       Int?

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@index([expiryDate])
}

model PropertyBankDetail {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  bankName          String
  beneficiaryName   String
  accountNumberEnc  String /// encrypted at rest
  ifscCodeEnc       String? /// encrypted
  accountType       String /// Savings, Current, etc.
  chequeDocumentUrl String? /// signed S3 URL

  verificationStatus String  @default("unverified") /// unverified, verified, failed
  applyToChain       Boolean @default(false) /// user flag to apply to all chain properties

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId]) /// one primary bank detail per property
  @@index([propertyId])
  @@index([verificationStatus])
}

// ============================================================================
// MULTI-SUPPLIER DISTRIBUTION NETWORK
// ============================================================================

model SupplierPartnership {
  id String @id @default(cuid())

  /// Source supplier (hotel/property owner)
  sourceSupplier    Tenant @relation("partnership_source", fields: [sourceSupplierStr], references: [id], onDelete: Cascade)
  sourceSupplierStr String @map("sourceSupplier")

  /// Target supplier (distributor/partner)
  targetSupplier    Tenant @relation("partnership_target", fields: [targetSupplierStr], references: [id], onDelete: Cascade)
  targetSupplierStr String @map("targetSupplier")

  /// Partnership type
  partnershipType String @default("public_inventory") /// public_inventory, exclusive, reserved

  /// Commission terms
  minCommissionPct     Float @default(8) /// Minimum % source gets
  maxCommissionPct     Float @default(25) /// Maximum % source gets
  defaultCommissionPct Float @default(15) /// Default commission for new rates

  /// Booking window (days)
  minBookingWindow Int @default(0) /// Days before arrival
  maxBookingWindow Int @default(365) /// Days in advance

  /// Markup rules
  maxMarkupPct Float @default(30) /// Max % target can add
  minMarkupPct Float @default(5) /// Min % to make deal worthwhile

  /// Geographic restrictions
  allowedCountries String[] @default([]) /// Empty = all countries allowed

  /// Status
  status       String    @default("active") /// active, suspended, terminated
  terminatedAt DateTime? /// When partnership was terminated

  /// Volume discounts
  volumeDiscounts Json? /// Array of {min_bookings: INT, commission_reduction: FLOAT}

  /// Performance metrics
  maxCancellationRate Float @default(20) /// Max % cancellations allowed
  minReviewScore      Float @default(3.5) /// Min review score

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryVisibilities InventoryVisibility[]
  commissionRules       SupplierCommissionRule[]

  @@unique([sourceSupplierStr, targetSupplierStr])
  @@index([sourceSupplierStr])
  @@index([targetSupplierStr])
  @@index([status])
}

model InventoryVisibility {
  id String @id @default(cuid())

  /// Original supplier (property owner)
  supplierTenant   Tenant @relation("inventory_supplier", fields: [supplierTenantId], references: [id], onDelete: Cascade)
  supplierTenantId String

  /// Property
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  /// Room type
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  /// Rate plan
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  ratePlanId String

  /// Visibility level
  visibilityLevel String @default("private") /// private, public, reserved

  /// Public configuration
  netRate         Float? /// Base rate supplier gets (for public inventory)
  maxMarkup       Float? /// Max % others can add
  commissionShare Float? /// % of net rate that goes to supplier

  /// Geographic visibility
  allowedCountries  String[] @default([]) /// Empty = all countries
  allowedCurrencies String[] @default(["USD"])

  /// Booking rules
  minBookingWindow Int @default(0)
  maxBookingWindow Int @default(365)

  /// Reserved inventory
  reservedFor        String? /// Partner tenant ID if reserved
  reservedAllocation Int? /// Units reserved for partner

  /// Inventory status
  status String @default("active") /// active, paused, blocked

  /// Relationships
  partnership   SupplierPartnership? @relation(fields: [partnershipId], references: [id])
  partnershipId String?

  revenueTransactions RevenueTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierTenantId, propertyId, roomId, ratePlanId, visibilityLevel])
  @@index([supplierTenantId])
  @@index([propertyId])
  @@index([visibilityLevel])
  @@index([status])
}

model SupplierCommissionRule {
  id String @id @default(cuid())

  /// Supplier this rule applies to
  supplier   Tenant @relation("commission_rules", fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String

  /// Optional: rule scoped to one partnership
  partnership   SupplierPartnership? @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  partnershipId String?

  /// Conditions for this rule
  country         String? /// Specific country (null = all countries)
  channel         String  @default("all") /// b2c, b2b, all
  partnerTier     String  @default("standard") /// gold, silver, bronze, standard
  season          String? /// peak, shoulder, off (null = all)
  minLengthOfStay Int     @default(1)
  maxLengthOfStay Int?

  /// Commission values
  baseCommissionPct     Float /// Base commission %
  variableCommissionPct Float  @default(0) /// Varies by demand
  capAmount             Float? /// Max commission amount

  /// Rule priority (higher = evaluated first)
  priority Int @default(0)

  /// Status
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([partnershipId])
  @@index([active])
  @@index([priority])
}

model RevenueTransaction {
  id String @id @default(cuid())

  /// Booking reference
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String

  /// Inventory reference
  inventoryVisibility   InventoryVisibility? @relation(fields: [inventoryVisibilityId], references: [id])
  inventoryVisibilityId String?

  /// Transaction type
  transactionType String   @default("booking") /// booking, cancellation, refund, adjustment
  transactionDate DateTime @default(now())

  /// Parties involved
  originSupplier  String /// Supplier ID (hotel owner)
  sellingSupplier String /// Supplier ID (distributor/partner)

  /// Amounts
  guestPaid    Float /// Total amount guest paid
  netToHotel   Float /// Net amount to hotel (commission included)
  markupAmount Float /// Markup added by distributor

  /// Commission details
  commissionToHotel Float /// Commission % paid to hotel
  platformFee       Float /// Platform processing fee
  paymentGatewayFee Float /// Payment gateway fee
  taxAmount         Float /// Taxes collected

  /// Status
  status         String    @default("pending") /// pending, settled, disputed, refunded
  settlementDate DateTime?

  /// For disputes
  disputeReason String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([originSupplier])
  @@index([sellingSupplier])
  @@index([transactionDate])
  @@index([status])
  @@index([settlementDate])
}

model SupplierInvoice {
  id String @id @default(cuid())

  /// Supplier being billed
  supplier   Tenant @relation("supplier_invoices", fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String

  /// Invoice details
  invoicePeriod String /// YYYY-MM format
  invoiceNumber String   @unique
  invoiceDate   DateTime @default(now())
  dueDate       DateTime

  /// Summary
  totalBookings     Int   @default(0)
  grossAmount       Float @default(0)
  platformFee       Float @default(0)
  paymentGatewayFee Float @default(0)
  netAmount         Float @default(0)

  /// Payment
  paymentMethod    String? /// bank_transfer, stripe, wallet
  status           String    @default("draft") /// draft, sent, paid, overdue
  sentDate         DateTime?
  paidDate         DateTime?
  paymentReference String?

  /// Line items (JSON array for flexibility)
  lineItems Json? /// Array of {booking_id, amount, type}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, invoicePeriod])
  @@index([supplierId])
  @@index([invoiceDate])
  @@index([status])
}

model SupplierSettlement {
  id String @id @default(cuid())

  /// Tenant that receives the money
  tenant   Tenant @relation("supplier_settlements", fields: [tenantId], references: [id], onDelete: Restrict)
  tenantId String

  /// seller: platform pays the selling supplier
  /// inter_supplier: selling supplier pays the inventory owner
  settlementType String
  payerTenantId  String? /// inter_supplier only (null = platform pays)

  bookingId String
  amount    Float
  currency  String @default("USD")

  status           String    @default("pending") /// pending, paid, overdue
  dueDate          DateTime?
  paidDate         DateTime?
  paymentReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One settlement of each type per booking: prevents double payouts
  @@unique([bookingId, settlementType])
  @@index([tenantId, settlementType, status])
  @@index([payerTenantId, status])
  @@index([dueDate])
}

// ============================================================================
// ROOMS & RATE INVENTORY
// ============================================================================

model Room {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type     String /// Standard, Deluxe, Suite, etc.
  code     String /// auto-generated per property
  quantity Int /// total number of this room type

  area             Float?
  areaUnit         String  @default("sqm") /// sqm, sqft
  viewType         String? /// Sea View, Garden View, etc.
  applicableForROH Boolean @default(false)
  description      String?

  status String @default("active")

  // Occupancy rules
  minAdults         Int    @default(1)
  maxAdults         Int    @default(2)
  maxOccupancy      Int    @default(2) /// including children
  minThresholdPrice Float? /// minimum rate for adult occupancy

  // Policies
  smokingPolicy String? /// smoking, non-smoking, both
  extraBeds     String? /// can it have extra beds? count allowed?
  amenityCodes  String[] /// JSON array of amenity codes

  photos RoomPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ratePlans     RatePlan[]
  calendarRates CalendarRate[]

  /// Phase 1: Inventory ledger
  inventoryLedger     InventoryLedger[]
  currentAvailability CurrentAvailability[]

  /// Multi-supplier visibility
  inventoryVisibilities InventoryVisibility[]

  @@unique([propertyId, code])
  @@index([propertyId])
  @@index([type])
}

model RoomPhoto {
  id     String @id @default(cuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  url   String /// signed S3 URL
  label String?

  createdAt DateTime @default(now())

  @@index([roomId])
}

model RatePlan {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  code      String /// auto-generated
  name      String
  boardType String /// BB, HB, FB, or custom

  status   String  @default("active")
  comments String?

  taxInclusive    Boolean @default(true)
  minLengthOfStay Int     @default(1)
  maxLengthOfStay Int?

  /// Phase 1: Blackout periods (JSON array: [{startDate, endDate, reason}])
  blackoutRanges String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  calendarRates CalendarRate[]

  /// Phase 1: Inventory ledger
  inventoryLedger     InventoryLedger[]
  currentAvailability CurrentAvailability[]

  /// Multi-supplier visibility
  inventoryVisibilities InventoryVisibility[]

  @@unique([propertyId, code])
  @@index([propertyId])
  @@index([roomId])
}

model CalendarRate {
  id         String @id @default(cuid())
  propertyId String /// denormalized for indexing

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  ratePlanId String
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  date    DateTime /// check-in date
  netRate Float /// the base, secret, never-shown rate

  availability Int     @default(999) /// rooms available this date
  stopSell     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, ratePlanId, date])
  @@index([propertyId, date])
  @@index([date])
}

