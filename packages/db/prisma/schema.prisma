  totalCommission    Float
  totalPayable       Float
  totalPaid          Float
  balance            Float

  // Status
  status     String    @default("pending") /// pending, approved, paid, disputed
  approvedAt DateTime?
  paidAt     DateTime?
  remarks    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, b2bAgentId, period])
  @@index([tenantId])
  @@index([status])
}

