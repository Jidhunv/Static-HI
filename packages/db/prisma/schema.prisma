  permissions String[] /// JSON array: ["hotel.view", "booking.create", etc.]
  level       Int /// 1=Admin, 2=MidOffice, 3=Finance/Sales, 4=FrontOffice, 5=B2BAgent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users TenantUser[] @relation("user_roles")

  @@unique([tenantId, name])
  @@index([tenantId])
