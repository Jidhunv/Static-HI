generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// TENANTS & AUTH
// ============================================================================

model Tenant {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique /// lowercase, used in subdomain
  businessType          String   /// hotel_chain, dmc, ota, wholesaler, travel_agency
  status                String   @default("pending") /// pending, active, suspended
  primaryCurrency       String   @default("USD")

  // Branding / white-label
  logoUrl               String?
  primaryColor          String?  @default("#7c3aed") /// default: lavender
  secondaryColor        String?
  fontFamily            String?  @default("inter") /// inter, roboto, poppins, etc.

  // Finance & KYC
  kycStatus             String   @default("pending") /// pending, verified, rejected
  kycDocuments          String[] /// JSON paths to uploaded docs
  bankAccountEncrypted  String?  /// encrypted JSON: {accountNumber, ifsc, beneficiaryName, accountType}
  panEncrypted          String?  /// encrypted
  gstEncrypted          String?  /// encrypted

  // Defaults
  defaultB2BMargin      Int      @default(15) /// percentage
  defaultB2CMarkup      Int      @default(25) /// percentage
  commissionRate        Int      @default(5)  /// platform take-rate on B2B/B2C, %

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  users                 TenantUser[]
  properties            Property[]
  suppliers             Supplier[]
  rateMarkups           RateMarkup[]
  outgoingDistributions DistributionGrant[] @relation("source_tenant")
  incomingDistributions DistributionGrant[] @relation("target_tenant")
  settings              TenantSettings?
  propertyConfigs       PropertyConfiguration[] @relation("tenant_property_config")
  propertyRates         PropertyRate[] @relation("tenant_rates")
  tenantBookings        Booking[] @relation("tenant_bookings")
  auditLogs             AuditLog[]
  b2bUsers              B2BUser[] @relation("b2b_users")
  roles                 TenantRole[] @relation("tenant_roles")
  b2bAgents             B2BAgent[] @relation("tenant_b2b_agents")
  commissions           Commission[] @relation("tenant_commissions")
  settlements           Settlement[] @relation("tenant_settlements")

  @@index([status])
  @@index([slug])
}

model TenantSettings {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Per-tenant master overrides
  allowedAmenities    String[] /// JSON array of amenity IDs this tenant can use
  allowedCountries    String[] /// restrict booking to certain countries
  bookingWindow       Int      @default(365) /// max days in advance

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
}

model TenantUser {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email               String
  password            String   /// hashed
  firstName           String
  lastName            String
  role                String   /// admin, staff

  // Staff scoping
  permissions         String[] /// module_view, module_edit, etc. — JSON array

  emailVerified       Boolean  @default(false)
  status              String   @default("active") /// active, inactive, suspended
  lastLogin           DateTime?

  roles               TenantRole[] @relation("user_roles")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model PlatformAdmin {
  id                  String   @id @default(cuid())
  email               String   @unique
  password            String   /// hashed
  name                String
  role                String   @default("admin") /// admin, superadmin
  status              String   @default("active") /// active, inactive, suspended
  lastLogin           DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([email])
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id                  String   @id @default(cuid())
  tenantId            String?  /// null if platform admin action
  tenant              Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId              String   /// TenantUser or PlatformAdmin ID
  userEmail           String
  userName            String

  action              String   /// create, update, delete, view, login, logout
  entity              String   /// User, Property, Booking, B2BAgent, Commission, Settlement
  entityId            String?  /// ID of affected entity
  entityName          String?  /// Name for readability

  changes             Json?    /// old vs new values {old: {}, new: {}}
  status              String   @default("success") /// success, failure
  errorMessage        String?
  ipAddress           String?
  userAgent           String?

  isArchived          Boolean  @default(false)
  archivedAt          DateTime?

  createdAt           DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@index([isArchived])
}

// ============================================================================
// PLATFORM MASTERS (not tenant-scoped)
// ============================================================================

model GlobalHotel {
  id                  String   @id @default(cuid())
  /// from source data import
  name                String
  address             String
  city                String
  state               String?
  country             String
  postalCode          String?
  latitude            Float
  longitude           Float
  starRating          Int?
  chainAffiliation    String?
  amenitiesMaster     String[] /// JSON array of standardized amenity codes

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  properties          Property[]

  @@unique([name, country, latitude, longitude]) /// prevent duplicates
  @@index([name, country])
  @@index([city, country])
}

model Country {
  id                  String   @id @default(cuid())
  code                String   @unique /// ISO 3166-1 alpha-2
  name                String   @unique
  createdAt           DateTime @default(now())

  states              State[]
  properties          Property[] @relation("property_country")

  @@index([name])
}

model State {
  id                  String   @id @default(cuid())
  countryId           String
  country             Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name                String
  code                String?
  createdAt           DateTime @default(now())

  properties          Property[] @relation("property_state")

  @@unique([countryId, name])
  @@index([countryId])
}

model City {
  id                  String   @id @default(cuid())
  name                String
  countryCode         String   /// denormalized for fast lookup
  createdAt           DateTime @default(now())

  @@unique([name, countryCode])
  @@index([name, countryCode])
}

model Currency {
  id                  String   @id @default(cuid())
  code                String   @unique /// USD, EUR, INR, etc.
  name                String
  symbol              String
  exchangeRate        Float    @default(1.0) /// vs USD base
  createdAt           DateTime @default(now())

  /// Phase 1: FX relations
  fxRatesAsBase       FXRate[] @relation("fx_base")
  fxRatesAsQuote      FXRate[] @relation("fx_quote")
}

model Amenity {
  id                  String   @id @default(cuid())
  code                String   @unique /// WIFI, AC, PARKING, etc.
  name                String
  category            String   /// wifi, climate, parking, entertainment, etc.
  icon                String?
  createdAt           DateTime @default(now())

  @@index([category])
}

model BedType {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String   /// Single, Double, Queen, King, Twin, etc.
  createdAt           DateTime @default(now())
}

model BoardCode {
  id                  String   @id @default(cuid())
  code                String   @unique /// BB, HB, FB, etc.
  name                String   /// Bed & Breakfast, Half Board, Full Board
  description         String?
  createdAt           DateTime @default(now())
}

model CancellationPolicyTemplate {
  id                  String   @id @default(cuid())
  name                String
  code                String   @unique
  description         String?
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([isDefault])
}

model Tax {
  id                  String   @id @default(cuid())
  name                String
  code                String   @unique /// VAT, GST, etc.
  percentage          Float
  isInclusive         Boolean  @default(false) /// in price or added on top
  createdAt           DateTime @default(now())

  @@index([code])
}

model Chain {
  id                  String   @id @default(cuid())
  name                String   @unique
  logo                String?
  createdAt           DateTime @default(now())
}

model LegalInformationType {
  id                  String   @id @default(cuid())
  name                String   @unique /// PAN Certificate, GST Certificate, etc.
  code                String   @unique
  createdAt           DateTime @default(now())
}

// ============================================================================
// PROPERTY & INVENTORY
// ============================================================================

model Property {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  globalHotelId       String?
  globalHotel         GlobalHotel? @relation(fields: [globalHotelId], references: [id])

  name                String
  code                String   /// auto-generated, unique per tenant
  type                String   /// Hotel, Resort, Hostel, Vacation Rental, etc.

  countryId           String
  country             Country  @relation("property_country", fields: [countryId], references: [id])
  stateId             String?
  state               State?   @relation("property_state", fields: [stateId], references: [id])
  city                String
  area                String?  /// Area/Region/District
  address             String
  postalCode          String?
  latitude            Float
  longitude           Float

  // Contact Info
  phone               String?
  email               String?
  website             String?

  // Amenities
  amenities           String[] /// JSON array of amenity names

  starCategory        Int?     /// 1-5 stars
  chainId             String?  /// FK to Chain
  chainName           String?  /// denormalized for fast lookup

  checkInTime         String   @default("14:00")
  checkOutTime        String   @default("12:00")

  status              String   @default("active") /// active, inactive, archived
  inactiveComment     String?

  // Policies
  allowEarlyCheckIn   Boolean  @default(false)
  allowLateCheckOut   Boolean  @default(false)
  allowChildren       String   @default("yes") /// yes, no
  childrenPolicy      String?  /// free child up to X, or text

  // Finance
  disableTDS          Boolean  @default(false)
  contractedBy        String[] /// JSON array of supplier IDs or names

  // Supplier flag
  isSupplier          Boolean  @default(false) /// if true, this property can also act as a supplier to others
  applicableForROH    Boolean  @default(false) /// Run of House

  // Visibility & Distribution
  visibility          String   @default("private") /// private, public_b2b, public_b2c, public_both
  distributionMode    String   @default("open") /// open, permissioned — only relevant if visibility includes b2b

  // Content
  description         String?
  usp                 String?  /// Unique Selling Proposition
  photos              PropertyPhoto[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  rooms               Room[]
  ratePlans           RatePlan[]
  policies            CancellationPolicy[]
  chargeRules         ChargeRule[]
  documents           PropertyDocument[]
  bankDetails         PropertyBankDetail[]
  suppliers           Supplier[] @relation("property_suppliers")
  promotions          Promotion[]
  bookings            Booking[] @relation("property_bookings")
  propertyConfig      PropertyConfiguration[] @relation("property_config")
  propertyRates       PropertyRate[] @relation("property_rates")

  /// Phase 1: Inventory ledger
  inventoryLedger     InventoryLedger[]
  currentAvailability CurrentAvailability[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([visibility])
  @@index([distributionMode])
  @@index([chainName])
  @@index([city])
}

model PropertyPhoto {
  id                  String   @id @default(cuid())
  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  url                 String   /// signed S3 URL
  label               String   /// Living Room, Bedroom, Pool, etc.
  imageName           String?
  isHero              Boolean  @default(false)

  createdAt           DateTime @default(now())

  @@index([propertyId])
}

model PropertyDocument {
  id                  String   @id @default(cuid())
  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  legalInformationType String
  documentUrl         String   /// signed S3 URL
  expiryDate          DateTime?
  reminder1Alert      Int?     /// days before expiry
  reminder2Alert      Int?
  reminder3Alert      Int?

  createdAt           DateTime @default(now())

  @@index([propertyId])
  @@index([expiryDate])
}

model PropertyBankDetail {
  id                  String   @id @default(cuid())
  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  bankName            String
  beneficiaryName     String
  accountNumberEnc    String   /// encrypted at rest
  ifscCodeEnc         String?  /// encrypted
  accountType         String   /// Savings, Current, etc.
  chequeDocumentUrl   String?  /// signed S3 URL

  verificationStatus  String   @default("unverified") /// unverified, verified, failed
  applyToChain        Boolean  @default(false) /// user flag to apply to all chain properties

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([propertyId]) /// one primary bank detail per property
  @@index([propertyId])
  @@index([verificationStatus])
}

// ============================================================================
// ROOMS & RATE INVENTORY
// ============================================================================

model Room {
  id                  String   @id @default(cuid())
  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type                String   /// Standard, Deluxe, Suite, etc.
  code                String   /// auto-generated per property
  quantity            Int      /// total number of this room type

  area                Float?
  areaUnit            String   @default("sqm") /// sqm, sqft
  viewType            String?  /// Sea View, Garden View, etc.
  applicableForROH    Boolean  @default(false)
  description         String?

  status              String   @default("active")

  // Occupancy rules
  minAdults           Int      @default(1)
  maxAdults           Int      @default(2)
  maxOccupancy        Int      @default(2) /// including children
  minThresholdPrice   Float?   /// minimum rate for adult occupancy

  // Policies
  smokingPolicy       String?  /// smoking, non-smoking, both
  extraBeds           String?  /// can it have extra beds? count allowed?
  amenityCodes        String[] /// JSON array of amenity codes

  photos              RoomPhoto[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  ratePlans           RatePlan[]
  calendarRates       CalendarRate[]

  /// Phase 1: Inventory ledger
  inventoryLedger     InventoryLedger[]
  currentAvailability CurrentAvailability[]

  @@unique([propertyId, code])
  @@index([propertyId])
  @@index([type])
}

model RoomPhoto {
  id                  String   @id @default(cuid())
  roomId              String
  room                Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  url                 String   /// signed S3 URL
  label               String?

  createdAt           DateTime @default(now())

  @@index([roomId])
}

model RatePlan {
  id                  String   @id @default(cuid())
  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomId              String?
  room                Room?    @relation(fields: [roomId], references: [id])

  code                String   /// auto-generated
  name                String
  boardType           String   /// BB, HB, FB, or custom

  status              String   @default("active")
  comments            String?

  taxInclusive        Boolean  @default(true)
  minLengthOfStay     Int      @default(1)
  maxLengthOfStay     Int?

  /// Phase 1: Blackout periods (JSON array: [{startDate, endDate, reason}])
  blackoutRanges      String?  @db.Text

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  calendarRates       CalendarRate[]

  /// Phase 1: Inventory ledger
  inventoryLedger     InventoryLedger[]
  currentAvailability CurrentAvailability[]

  @@unique([propertyId, code])
  @@index([propertyId])
  @@index([roomId])
}

model CalendarRate {
  id                  String   @id @default(cuid())
  propertyId          String   /// denormalized for indexing

  roomId              String
  room                Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  ratePlanId          String
  ratePlan            RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  date                DateTime /// check-in date
  netRate             Float    /// the base, secret, never-shown rate

  availability        Int      @default(999) /// rooms available this date
  stopSell            Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([roomId, ratePlanId, date])
  @@index([propertyId, date])
  @@index([date])
}

// ============================================================================
// CANCELLATION POLICIES
// ============================================================================

model CancellationPolicy {
  id                  String   @id @default(cuid())
  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  bookingType         String   /// Refundable, Non-Refundable
  status              String   @default("active")
  templateId          String?  /// FK to CancellationPolicyTemplate if based on template
  templateName        String?

  customName          String?  /// if custom, the custom name
  isDefault           Boolean  @default(false)

  applicableStartDate DateTime?
  applicableEndDate   DateTime?
  applicableDateType  String?  /// by_booking_date, by_stay_date

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  tiers               CancellationPolicyTier[]
  applicableRooms     String[] /// room type codes, JSON array
  applicableRatePlans String[] /// rate plan codes, JSON array

  @@index([propertyId])
  @@index([isDefault])
}

model CancellationPolicyTier {
  id                  String   @id @default(cuid())
  policyId            String
  policy              CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  templateTierId      String?  /// if from template, reference original

  refundType          String   /// Full Refund, Partial Refund, No Refund
  daysBeforeArrival   Int      /// cancellation window
  arrivalTime         String?  /// optional time constraint
  chargeType          String   /// Percentage, Fixed
  chargeValue         Float    /// % or fixed amount

  createdAt           DateTime @default(now())

  @@index([policyId])
}

// ============================================================================
// CHARGE RULES (Fees, Surcharges, Supplements)
// ============================================================================

model ChargeRule {
  id                  String   @id @default(cuid())
  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  kind                String   /// fee, surcharge, supplement
  name                String
  applicability       String   @default("room") /// room, rate_plan

  appliedToRoomTypes  String[] /// codes, JSON array
  appliedToRatePlans  String[] /// codes, JSON array

  amountType          String   /// flat, percentage
  value               Float    /// amount or percentage

  dateRangeStart      DateTime?
  dateRangeEnd        DateTime?
  mandatory           Boolean  @default(false)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([propertyId, kind])
}

// ============================================================================
// PROMOTIONS
// ============================================================================

model Promotion {
  id                  String   @id @default(cuid())
  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type                String   /// basic, long_stay, early_bird, last_minute, extra_inclusion, performance_linked
  name                String
  code                String   @unique

  status              String   @default("active")
  description         String?

  /// Applicability & Trigger
  roomTypes           String[] /// JSON array of room type codes
  ratePlans           String[] /// JSON array of rate plan codes

  dateStart           DateTime
  dateEnd             DateTime

  triggerCondition    String   @db.Text /// JSON: {"type": "...", ...}
  discountType        String   /// percentage, fixed, free_nights
  discountValue       Float

  applicableToLOS     Int?     /// for long stay: min LOS to trigger

  /// for extra inclusion
  includeExtraIds     String[] /// JSON array of charge rule IDs

  /// for performance linked
  volumeThresholds    String?  /// JSON: [{nights: 10, discount: 5}, {nights: 20, discount: 10}]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  rules               PromotionRule[]

  @@index([propertyId])
  @@index([status])
  @@index([dateStart, dateEnd])
}

model PromotionRule {
  id                  String   @id @default(cuid())
  promotionId         String
  promotion           Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  priority            Int      @default(0)
  ruleJson            String   @db.Text /// serialized rule logic

  @@index([promotionId, priority])
}

// ============================================================================
// SUPPLIERS
// ============================================================================

model Supplier {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                String
  accountingName      String?
  type                String   /// Source, Channel Manager, GDS, etc.
  category            String   /// Direct Connect, API, Manual, etc.

  contractFrom        DateTime?
  contractTo          DateTime?
  isContractSigned    Boolean  @default(false)

  logoUrl             String?
  status              String   @default("active")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  documents           SupplierDocument[]
  offices             SupplierOffice[]
  properties          Property[] @relation("property_suppliers")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model SupplierDocument {
  id                  String   @id @default(cuid())
  supplierId          String
  supplier            Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  documentName        String
  documentUrl         String   /// signed S3 URL

  createdAt           DateTime @default(now())

  @@index([supplierId])
}

model SupplierOffice {
  id                  String   @id @default(cuid())
  supplierId          String
  supplier            Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  officeName          String
  address             String?
  city                String?
  country             String?
  contactName         String?
  phone               String?
  email               String?

  createdAt           DateTime @default(now())

  @@index([supplierId])
}

// ============================================================================
// PROPERTY CONFIGURATION & RATES (Tenant-Scoped)
// ============================================================================

model PropertyConfiguration {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation("tenant_property_config", fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId          String
  property            Property @relation("property_config", fields: [propertyId], references: [id], onDelete: Cascade)

  // Tenant-specific configuration
  amenities           String[] /// JSON array
  cancellationPolicy  String?
  otherPolicies       String?

  // Finance details for this tenant's use of this property
  financeManager      Json?    /// {name, phone, email}
  salesperson         Json?    /// {name, phone, email}
  bankDetails         Json?    /// {bankName, accountNumber, ifscCode, beneficiaryName}
  moneyTransfer       String?
  contractStartDate   DateTime?
  contractEndDate     DateTime?
  contractUrl         String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  rates               PropertyRate[]

  @@unique([tenantId, propertyId])
  @@index([tenantId])
  @@index([propertyId])
}

model PropertyRate {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation("tenant_rates", fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId          String
  property            Property @relation("property_rates", fields: [propertyId], references: [id], onDelete: Cascade)

  configId            String
  config              PropertyConfiguration @relation(fields: [configId], references: [id], onDelete: Cascade)

  roomType            String   /// Single, Double, Suite, etc.
  rateType            String   /// domestic, international
  startDate           DateTime
  endDate             DateTime
  weekdays            String[] /// MON, TUE, WED, etc. - JSON array
  rate                Float    /// per night rate

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId, propertyId])
  @@index([startDate, endDate])
}

// ============================================================================
// BOOKINGS & VOUCHERS
// ============================================================================

model Booking {
  id                  String   @id @default(cuid())
  propertyId          String
  property            Property @relation("property_bookings", fields: [propertyId], references: [id])

  // Tenant Relations (one of these will be set depending on booking type)
  tenantId            String
  tenant              Tenant   @relation("tenant_bookings", fields: [tenantId], references: [id], onDelete: Cascade)

  // B2B Agent Tracking
  b2bAgentId          String?
  b2bAgent            B2BAgent? @relation("b2b_agent_bookings", fields: [b2bAgentId], references: [id])

  // B2B/B2C specific fields
  bookingCode         String?  /// Unique booking reference
  bookingType         String?  /// b2b, b2c, walk_in
  sourceTenantId      String?  /// For B2B reseller bookings - original property owner
  resellerTenantId    String?  /// For B2B reseller bookings - reseller tenant

  // Confirmation Numbers
  systemConfirmationNo String @unique /// Auto-generated: CONF-YYYYMMDD-XXXXX
  hotelConfirmationNo String?         /// From hotel system

  // Guest Information
  guestName           String
  guestEmail          String
  guestPhone          String?

  // Booking Details
  roomType            String
  roomTypeCode        String?  /// Code for specific room type
  ratePlanCode        String?  /// Code for specific rate plan
  checkInDate         DateTime
  checkOutDate        DateTime
  numberOfNights      Int
  numberOfGuests      Int
  adults              Int?     /// B2B specific
  children            Int?     /// B2B specific
  rateType            String   /// domestic, international
  rateAmount          Float    /// per night
  totalAmount         Float
  currency            String   @default("USD")

  // B2B Rate tracking
  netRate             Float?   /// Before markup
  subtotal            Float?   /// For B2B tracking

  // Booking Source & Status
  source              String   /// b2b, b2c, walk_in
  status              String   @default("pending") /// pending, confirmed, checked_in, checked_out, cancelled
  cancelledAt         DateTime?

  // Special Requests
  specialRequests     String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  confirmedAt         DateTime?

  // Relations
  voucher             BookingVoucher?
  commission          Commission?
  items               BookingItem[]
  rateBreakdown       RateBreakdown?
  payment             Payment?

  @@index([tenantId, propertyId])
  @@index([checkInDate, checkOutDate])
  @@index([status])
  @@index([bookingCode])
  @@index([sourceTenantId])
  @@index([resellerTenantId])
}

model BookingVoucher {
  id                  String   @id @default(cuid())
  bookingId           String   @unique
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Voucher Details
  voucherNo           String   @unique /// Generated from booking confirmation
  hotelName           String
  hotelAddress        String
  hotelPhone          String?
  hotelEmail          String?
  hotelWebsite        String?

  // Guest Details
  guestName           String
  guestEmail          String
  guestPhone          String?

  // Stay Details
  checkInDate         String
  checkOutDate        String
  numberOfNights      Int
  roomType            String
  rate                String   /// per night

  // Total
  subtotal            Float
  tax                 Float
  total               Float
  currency            String

  // Branding
  hotelLogo           String?  /// Logo URL
  primaryColor        String?  /// Hex color from tenant
  secondaryColor      String?
  tenantName          String?  /// Issuing organization

  // Voucher Status
  voucherUrl          String?  /// PDF or HTML URL
  generatedAt         DateTime
  validFrom           DateTime
  validUntil          DateTime

  createdAt           DateTime @default(now())

  @@index([bookingId])
}

// ============================================================================
// TENANT USERS & ROLES (Multi-level User Management)
// ============================================================================

model TenantRole {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation("tenant_roles", fields: [tenantId], references: [id], onDelete: Cascade)

  name                String   /// Admin, MidOffice, FrontOffice, Finance, Sales
  description         String?
  permissions         String[] /// JSON array: ["hotel.view", "booking.create", etc.]
  level               Int      /// 1=Admin, 2=MidOffice, 3=Finance/Sales, 4=FrontOffice, 5=B2BAgent

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users               TenantUser[] @relation("user_roles")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model B2BAgent {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation("tenant_b2b_agents", fields: [tenantId], references: [id], onDelete: Cascade)

  // Agent Details
  name                String   /// Agent company/name
  email               String
  phone               String?
  website             String?
  address             String?
  city                String?
  country             String?

  // Branding
  logoUrl             String?  /// Agent's own logo
  primaryColor        String?  @default("#3b82f6")
  secondaryColor      String?  @default("#60a5fa")

  // Commission
  commissionRate      Float    @default(10) /// percentage
  commissionType      String   @default("percentage") /// percentage or fixed

  // Status & Verification
  status              String   @default("active") /// active, inactive, suspended
  kycVerified         Boolean  @default(false)
  kycDocuments        String[] /// JSON array

  // Contact Details
  contactPerson       String?
  contactPhone        String?
  contactEmail        String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  users               B2BAgentUser[]
  bookings            Booking[] @relation("b2b_agent_bookings")
  commissions         Commission[]
  settlements         Settlement[] @relation("agent_settlements")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([status])
}

model B2BAgentUser {
  id                  String   @id @default(cuid())
  agentId             String
  agent               B2BAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  email               String
  password            String   /// hashed
  firstName           String
  lastName            String
  role                String   @default("user") /// admin, user

  status              String   @default("active")
  lastLogin           DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([agentId, email])
  @@index([agentId])
}

// ============================================================================
// COMMISSION & FINANCIAL TRACKING
// ============================================================================

model Commission {
  id                  String   @id @default(cuid())
  bookingId           String   @unique
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  b2bAgentId          String?
  b2bAgent            B2BAgent? @relation(fields: [b2bAgentId], references: [id])

  tenantId            String
  tenant              Tenant   @relation("tenant_commissions", fields: [tenantId], references: [id])

  // Commission Details
  bookingAmount       Float
  commissionRate      Float    /// percentage
  commissionAmount    Float    /// calculated
  commissionType      String   /// percentage, fixed

  // Status
  status              String   @default("pending") /// pending, approved, paid
  paidAt              DateTime?
  paidAmount          Float?

  // Breakdown
  breakdown           Json?    /// {hotelShare, agentShare, platformShare}

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId, b2bAgentId])
  @@index([bookingId])
  @@index([status])
}

model Settlement {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation("tenant_settlements", fields: [tenantId], references: [id], onDelete: Cascade)

  b2bAgentId          String?
  b2bAgent            B2BAgent? @relation("agent_settlements", fields: [b2bAgentId], references: [id])

  // Settlement Period
  startDate           DateTime
  endDate             DateTime
  period              String   /// "2026-07" (YYYY-MM)

  // Amounts
  totalBookingAmount  Float
  totalCommission     Float
  totalPayable        Float
  totalPaid           Float
  balance             Float

  // Status
  status              String   @default("pending") /// pending, approved, paid, disputed
  approvedAt          DateTime?
  paidAt              DateTime?
  remarks             String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, b2bAgentId, period])
  @@index([tenantId])
  @@index([status])
}

// ============================================================================
// B2B USER (for B2B portal access - simplified)
// ============================================================================

model B2BUser {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation("b2b_users", fields: [tenantId], references: [id], onDelete: Cascade)

  email               String
  password            String   /// hashed
  firstName           String
  lastName            String
  companyName         String?
  companyPhone        String?

  role                String   @default("user") /// admin, user
  status              String   @default("active")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ============================================================================
// RATE MARKUP & DISTRIBUTION
// ============================================================================

model RateMarkup {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channel             String   /// b2b, b2c

  /// Optional scoping
  sourceTenantId      String?  /// for b2b: only when reselling this specific tenant's inventory
  roomTypeCode        String?  /// applies to this room type

  dateStart           DateTime?
  dateEnd             DateTime?
  minLOS              Int?

  /// Markup rule
  type                String   /// percentage, fixed
  value               Float
  priority            Int      @default(0) /// higher = more specific, wins in conflict

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, channel, sourceTenantId, roomTypeCode, dateStart, dateEnd, minLOS])
  @@index([tenantId, channel])
  @@index([priority])
}

model DistributionGrant {
  id                  String   @id @default(cuid())
  sourceTenantId      String
  sourceTenant        Tenant   @relation("source_tenant", fields: [sourceTenantId], references: [id], onDelete: Cascade)

  targetTenantId      String
  targetTenant        Tenant   @relation("target_tenant", fields: [targetTenantId], references: [id], onDelete: Cascade)

  status              String   @default("pending") /// pending, approved, rejected

  /// Optional bilateral override
  customB2BMargin     Int?     /// % margin override just for this grant

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([sourceTenantId, targetTenantId])
  @@index([sourceTenantId])
  @@index([targetTenantId])
  @@index([status])
}

// ============================================================================
// BOOKINGS & PAYMENTS - Models below removed (duplicate Booking model)
// ============================================================================

model BookingItem {
  id                  String   @id @default(cuid())
  bookingId           String
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  itemType            String   /// room, fee, surcharge, tax, discount
  description         String
  quantity            Int      @default(1)
  unitPrice           Float
  total               Float    /// quantity * unitPrice

  @@index([bookingId])
}

model RateBreakdown {
  id                  String   @id @default(cuid())
  bookingId           String   @unique
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  sourceTenantId      String   /// base data for audit
  resellerTenantId    String?

  netRate             Float    /// per night, secret
  b2bMarginApplied    Float?   /// if B2B, markup applied by source
  marketplaceRate     Float?   /// netRate + b2bMarginApplied
  resellerMarkup      Float?   /// reseller's own markup

  b2cMarkupApplied    Float?   /// if B2C, direct markup applied

  taxTotal            Float
  feesTotal           Float
  surchargesTotal     Float

  finalRate           Float    /// the final sell rate

  /// JSON audit trail
  markupHistory       String   @db.Text /// [{applied_by: tenant_id, type: "b2b" | "b2c", value, timestamp}]

  @@index([sourceTenantId])
  @@index([resellerTenantId])
}

model Payment {
  id                  String   @id @default(cuid())
  bookingId           String   @unique
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  status              String   @default("pending") /// pending, succeeded, failed
  method              String   @default("stripe") /// stripe, bank_transfer, etc.

  stripePaymentIntentId String?
  stripeConnectAccountId String? /// the tenant's stripe account ID

  amount              Float
  currency            String

  platformCommission  Float    /// platform's take
  tenantCredit        Float    /// amount credited to tenant

  createdAt           DateTime @default(now())
  completedAt         DateTime?

  @@index([bookingId])
  @@index([status])
}

// ============================================================================
// PHASE 1: FOUNDATIONAL FEATURES
// ============================================================================

// 1. ENTITY APPROVAL PATTERN (Reusable for Tenant & B2B Agent)
model EntityApproval {
  id                  String   @id @default(cuid())

  entityType          String   /// Tenant, B2BAgent
  entityId            String

  status              String   @default("pending") /// pending, confirmed, suspended

  approverUserId      String?  /// who approved/rejected
  approverEmail       String?
  approverName        String?

  approvalNotes       String?  @db.Text
  actionTakenAt       DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([status])
  @@index([createdAt])
}

// 2. INVENTORY LEDGER (Append-only, foundational for booking consistency)
model InventoryLedger {
  id                  String   @id @default(cuid())

  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomId              String
  room                Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  ratePlanId          String
  ratePlan            RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  date                DateTime /// The date this availability applies to

  delta               Int      /// Positive or negative availability change
  reason              String   /// manual_allocation, booking, cancellation_release, amendment, blackout_block

  actorUserId         String?  /// User who triggered this change
  actorEmail          String?

  bookingId           String?  /// If reason=booking/cancellation/amendment, link to booking

  createdAt           DateTime @default(now())

  /// Immutable: this row is never updated or deleted

  @@index([propertyId, roomId, ratePlanId, date])
  @@index([reason])
  @@index([bookingId])
  @@index([createdAt])
}

// 3. CURRENT AVAILABILITY (Materialized view for fast reads, updated transactionally with ledger)
model CurrentAvailability {
  id                  String   @id @default(cuid())

  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  roomId              String
  room                Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  ratePlanId          String
  ratePlan            RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  date                DateTime

  available           Int      /// Sum of all delta in InventoryLedger for this (property, room, rate, date)

  lastUpdatedAt       DateTime @updatedAt

  @@unique([propertyId, roomId, ratePlanId, date])
  @@index([propertyId, roomId, ratePlanId, date])
}

// 4. FX RATES (Manual + API-driven)
model FXRate {
  id                  String   @id @default(cuid())

  baseCurrencyId      String
  baseCurrency        Currency @relation("fx_base", fields: [baseCurrencyId], references: [id], onDelete: Cascade)

  quoteCurrencyId     String
  quoteCurrency       Currency @relation("fx_quote", fields: [quoteCurrencyId], references: [id], onDelete: Cascade)

  rate                Decimal  @db.Decimal(18, 8) /// 1 base = rate quote
  source              String   /// manual, api

  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  @@unique([baseCurrencyId, quoteCurrencyId])
  @@index([updatedAt])
}

