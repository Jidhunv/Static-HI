# ============ DATABASE ============
DATABASE_URL="postgresql://user:password@localhost:5432/hoteldb"

# ============ JWT & SECURITY ============
# Required. Private random value, at least 32 characters. The API will not start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION="24h"
ENCRYPTION_KEY="your-256-bit-encryption-key-hex-encoded"

# ============ API CONFIG ============
PORT=3001
NODE_ENV="development" # development, staging, production
API_VERSION="v1"

# ============ CORS ============
CORS_ORIGINS="http://localhost:3200,http://localhost:3001"

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LONG_WINDOW_MS=3600000
RATE_LIMIT_LONG_MAX_REQUESTS=1000

# ============ LOGGING ============
LOG_LEVEL="debug" # debug, info, warn, error
LOG_FORMAT="json" # json, text

# ============ EMAIL (Optional) ============
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# ============ STORAGE (Optional) ============
AWS_ACCESS_KEY_ID="your-aws-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_S3_BUCKET="your-bucket-name"
AWS_REGION="us-east-1"

# ============ THIRD PARTY INTEGRATIONS ============
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLIC_KEY="pk_test_..."

# ============ FEATURE FLAGS ============
ENABLE_B2B_BOOKING=false
ENABLE_B2C_BOOKING=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=true